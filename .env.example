# Порт веб-сервера
PORT=3000

# Пароль для входа в сервис (если пусто — вход без пароля, только для локальной работы)
APP_PASSWORD=
# Любая длинная случайная строка — чтобы сессии не сбрасывались после перезапуска
SESSION_SECRET=

# Где хранить базу (SQLite-файл)
DB_PATH=./data/otpravki.db

# ---- Google Sheets ----
# ID таблицы из ссылки docs.google.com/spreadsheets/d/<ID>/edit
SPREADSHEET_ID=1daZLTn20ExCasdwpCW9bgayToJT1DUwolHC2r80b8II
# Ключ сервисного аккаунта: путь к JSON-файлу…
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# …или содержимое JSON (можно в base64) прямо в переменной
# GOOGLE_SERVICE_ACCOUNT_JSON=
